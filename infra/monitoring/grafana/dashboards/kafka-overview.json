      "targets": [{"expr": "max by (topic) (kafka_topic_partitions{job=\"kafka\"})", "legendFormat": "{{topic}}", "refId": "A"}],
      "title": "Topic partitions",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
