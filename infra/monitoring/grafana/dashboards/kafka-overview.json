      "targets": [{"expr": "kafka_brokers{job=\"kafka\"}", "legendFormat": "brokers", "refId": "A"}],
      "title": "Kafka brokers",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
