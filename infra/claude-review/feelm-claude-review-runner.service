[Unit]
Description=Feelm Claude 리뷰 Runner (보호된 CI 전용)
Wants=network-online.target
Requires=feelm-claude-review-guard.service
After=network-online.target feelm-claude-review-guard.service
ConditionPathExists=/home/feelm-ci-review/gitlab-runner/config.toml
# 네트워크 경계와 신뢰된 CI를 검증할 때까지 비활성 상태로 유지한다.
ConditionPathExists=/etc/feelm-ci-review/enable-runner

[Service]
Type=simple
User=feelm-ci-review
Group=feelm-ci-review
WorkingDirectory=/home/feelm-ci-review/gitlab-runner
Environment=HOME=/home/feelm-ci-review
Environment=PATH=/home/feelm-ci-review/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=DISABLE_AUTOUPDATER=1
UMask=0077
# root 소유의 고정 검증기만 권한을 높여 실행하며 Runner 계정에는 sudo 권한을 주지 않는다.
ExecStartPre=+/usr/bin/python3 -I -B /usr/local/lib/feelm-ci-review/network-guard.py verify
ExecStart=/usr/bin/gitlab-runner run --config /home/feelm-ci-review/gitlab-runner/config.toml --working-directory /home/feelm-ci-review/gitlab-runner
Restart=on-failure
RestartSec=10
KillSignal=SIGQUIT
TimeoutStopSec=90
KillMode=control-group
CPUQuota=100%
MemoryHigh=2G
MemoryMax=3G
MemorySwapMax=0
TasksMax=128
LimitNOFILE=4096
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=tmpfs
BindPaths=/home/feelm-ci-review
ReadWritePaths=/home/feelm-ci-review
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
InaccessiblePaths=-/run/docker.sock -/run/containerd -/run/dbus -/run/systemd/private -/run/user -/var/lib/docker -/var/lib/containerd -/etc/gitlab-runner -/etc/feelm-ci222 -/srv

[Install]
WantedBy=multi-user.target
