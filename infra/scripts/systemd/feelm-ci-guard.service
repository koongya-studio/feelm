[Unit]
Description=Feelm CI 222 reviewed test-account network guard
After=ufw.service
Before=user@1001.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=root
ExecStart=/usr/bin/python3 -I /usr/local/lib/feelm-ci222/ci-guard-service.py ensure
ExecReload=/usr/bin/python3 -I /usr/local/lib/feelm-ci222/ci-guard-service.py verify
# Intentionally no ExecStop: stopping this service must not remove firewall rules.
TimeoutStartSec=120
UMask=0077
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
