# 필수. J15E106 서비스 노드 사설 IP
# Nginx, 애플리케이션 서비스, HDFS DataNode 1, Spark Worker 1
SERVICE_NODE_IP=

# 필수. J15E106A 분산 처리 노드 사설 IP
# HDFS NameNode·DataNode 2, Spark Master·Worker 2, Kafka
DISTRIBUTED_NODE_IP=

# 필수, 비밀정보 아님. KRaft 클러스터 최초 구성 시 한 번 생성
# kafka_data 볼륨을 유지하는 동안 값을 변경하지 않음
KAFKA_CLUSTER_ID=

# 두 서버에서 동일하게 사용할 로컬 Spark ML 이미지 이름과 태그
SPARK_IMAGE=feelm-spark-ml:4.1.3-numpy2.2.6

# 선택. J15E106에서 사용할 Nginx 호스트 포트
NGINX_PORT=80

# 선택. 모니터링 HTTP 포트는 기본적으로 서비스 호스트 루프백에만 바인딩
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
LOKI_PORT=3100
ALLOY_PORT=12345

# 정상 운영값. 장애 시 SSH 터널 복구 절차에서만 임시로 덮어씀
GRAFANA_ROOT_URL=https://j15e106.p.ssafy.io/grafana/
GRAFANA_SERVE_FROM_SUB_PATH=true

# 필수 Secret. Grafana 최초 관리자 계정에 사용하며 실제 값은 infra/.env에만 저장
GRAFANA_ADMIN_PASSWORD=

# 필수 Secret. Grafana와 내부 Mattermost 알림 릴레이 사이의 HMAC 서명 키
# 충분히 긴 임의값을 infra/.env 또는 GitLab CI/CD Variables에만 저장
GRAFANA_ALERT_HMAC_SECRET=

# 선택. Mattermost 알림 릴레이 health endpoint의 서비스 호스트 루프백 포트
GRAFANA_ALERT_RELAY_PORT=9087

# Grafana 공개 경로 활성화 시 필수. 별도 Basic Auth 파일이 있는 서버 호스트 절대 경로
# 파일에는 bcrypt 해시만 저장하고 저장소에 추가하지 않음
GRAFANA_HTPASSWD_PATH=

# 선택. Prometheus 로컬 보존 기간
PROMETHEUS_RETENTION_TIME=15d

# 선택. 공유 서버에서 Swagger UI와 OpenAPI 문서를 활성화할지 여부
SWAGGER_ENABLED=false

# 선택. Swagger를 활성화할 때 팀 공통 Basic Auth 파일의 서버 호스트 절대 경로
# 비활성 환경은 /dev/null을 사용하며 파일 내용은 저장소에 추가하지 않음
SWAGGER_HTPASSWD_PATH=

# 필수. PostgreSQL 컨테이너 초기화에 사용할 데이터베이스와 사용자
POSTGRES_DB=feelm
POSTGRES_USER=feelm
POSTGRES_PASSWORD=

# 필수. GitLab Registry의 백엔드 이미지와 불변 태그(commit SHA)
BACKEND_IMAGE=

# 서비스 전체 기동 시 사용할 프론트엔드 이미지와 불변 태그(commit SHA)
# 프론트엔드 단독 자동 배포에서는 배포 Job이 후보 이미지를 직접 주입
FRONTEND_IMAGE=

# 서비스 노드의 영속 프로필 사진 디렉터리. Backend는 쓰고 Nginx는 읽기 전용으로 마운트한다.
AVATAR_HOST_PATH=/srv/feelm/data/avatars
AVATAR_PUBLIC_URL_PREFIX=/media/avatars

# 서비스 노드의 비공개 리포트 PNG 디렉터리. Backend에만 마운트하며 Nginx에는 연결하지 않는다.
REPORT_IMAGE_HOST_PATH=/srv/feelm/data/report-images
# 필수 Secret. JWT_SECRET과 다른 32바이트 이상의 임의 값이며 실제 값은 infra/.env에만 둔다.
REPORT_IMAGE_SIGNING_SECRET=

# 백엔드가 Compose 내부 PostgreSQL에 연결할 때 사용
DB_URL=jdbc:postgresql://postgres:5432/feelm
DB_USERNAME=feelm

# 필수 Secret. POSTGRES_PASSWORD와 같은 값
DB_PASSWORD=

# 백엔드가 Compose 내부 Redis에 연결할 때 사용
REDIS_HOST=redis
REDIS_PORT=6379

# 필수 Secret. Redis 인증에 사용하며 실제 값은 infra/.env에만 저장
REDIS_PASSWORD=

# 기본값은 루프백이다. 분산 Consumer를 실행할 때만 두 값을 SERVICE_NODE_IP와 같은
# 서비스 노드 사설 IP로 설정한다. 이 경우 DOCKER-USER의 첫 규칙에서
# DISTRIBUTED_NODE_IP/32 외의 5432/6379 전달을 차단해야 배포 검증을 통과한다.
POSTGRES_BIND_ADDRESS=127.0.0.1
REDIS_BIND_ADDRESS=127.0.0.1

# 수동 실행 기본값. main 자동 배포는 CI가 게시한 커밋 SHA 이미지 digest로 이 값을 덮어쓴다.
CONSUMER_IMAGE=feelm-foldin-consumer:local
CONSUMER_KAFKA_TOPIC=feelm.rating.v1
CONSUMER_DISMISS_KAFKA_TOPIC=feelm.dismiss.v1
CONSUMER_KAFKA_GROUP_ID=feelm-foldin-consumer-v1

# 개인/파티 공용 실행 선택. 이미지 배포만으로 모델이 전환되지 않는다.
# 644 준비 이미지 검증 후 628/735의 승인된 전환에서만 gbt로 설정한다.
CONSUMER_RUNTIME=legacy
# gbt에서 필수: 626 불변 bundle URI와 독립 검증된 manifest SHA256(sha256:<64 hex>).
CONSUMER_GBT_BUNDLE_URI=
CONSUMER_GBT_SERVING_REVISION=
# gbt에서 필수: 양쪽 동일 입력 byte 예산(1~67108864), 개인의 이전 입력 보존 초(1~2147483647).
# 운영 사용자 수·Kafka 지연/재시도 기간을 측정해 결정한다. 임의 기본값 없음.
CONSUMER_GBT_MAX_SNAPSHOT_BYTES=
CONSUMER_GBT_SNAPSHOT_RETENTION_SECONDS=

# 필수 Secret. 비밀번호에 예약 문자가 있으면 URL encoding한 값을 infra/.env에만 저장한다.
CONSUMER_POSTGRES_DSN=
CONSUMER_REDIS_URL=

# legacy에서 필수. gbt에서는 필요하지 않으며 첫 전환 시 개인/파티 ALS URI를 제거한다.
# 같은 immutable snapshot revision의 HDFS URI 세 개를 사용한다.
CONSUMER_MODEL_URI=
CONSUMER_MAPPING_URI=
CONSUMER_METADATA_URI=

# 선택. 설정하면 ALS+콘텐츠 하이브리드 후보를 생성한다. 모델과 같은 snapshot revision의
# immutable content-artifacts-v2 URI만 사용하며 latest 또는 staging 경로를 사용하지 않는다.
CONSUMER_CONTENT_URI=
CONSUMER_HYBRID_ALPHA=0.5
CONSUMER_DISMISS_SCORE=1.0
CONSUMER_DISMISS_INPUT_VERSION=dismiss-virtual-rating-v1

# 선택. 그룹 기반 DISCOVERY를 활성화할 때 둘을 함께 설정한다. 두 immutable 산출물은
# 같은 mapping revision이어야 하며 latest 또는 staging 경로를 사용하지 않는다.
CONSUMER_GROUP_URI=
CONSUMER_DISCOVERY_POPULARITY_URI=

# 선택. Consumer 오류 재시도와 Kafka poll 제어값
CONSUMER_RETRY_ATTEMPTS=3
CONSUMER_RETRY_BACKOFF_SECONDS=0.25
CONSUMER_KAFKA_POLL_TIMEOUT_SECONDS=1.0
CONSUMER_MAX_PAUSED_POLLS=30

# 파티 추천 전용 Consumer. 개인 Fold-in Consumer와 별도 프로세스·Kafka Group으로 실행한다.
PARTY_CONSUMER_KAFKA_TOPIC=feelm.party-refresh.v1
PARTY_CONSUMER_KAFKA_GROUP_ID=feelm-party-consumer-v1

# 필수 Secret. CONSUMER_REDIS_URL과 같은 Redis를 사용해도 실제 값은 infra/.env에만 저장한다.
PARTY_CONSUMER_REDIS_URL=

# legacy에서 필수. gbt는 위 공용 GBT bundle/revision을 사용한다.
# 개인 Consumer와 같은 immutable snapshot revision의 HDFS URI 세 개를 사용한다.
PARTY_CONSUMER_MODEL_URI=
PARTY_CONSUMER_MAPPING_URI=
PARTY_CONSUMER_METADATA_URI=

# 선택. 파티 Consumer 오류 재시도와 Kafka poll 제어값
PARTY_CONSUMER_RETRY_ATTEMPTS=3
PARTY_CONSUMER_RETRY_BACKOFF_SECONDS=0.25
PARTY_CONSUMER_KAFKA_POLL_TIMEOUT_SECONDS=1.0
PARTY_CONSUMER_MAX_PAUSED_POLLS=30

# 선택. Kafka 아웃박스 운영 초기값이며 실측 결과에 따라 조정
KAFKA_OUTBOX_POLL_INTERVAL=500ms
KAFKA_OUTBOX_BATCH_SIZE=100
KAFKA_OUTBOX_MAX_RETRY_DELAY=30s
KAFKA_OUTBOX_PUBLISHED_RETENTION=7d
KAFKA_OUTBOX_CLEANUP_INTERVAL=1h

# 선택 Secret. 별도 조회 계정용 비밀번호. 비어 있으면 조회 계정 비활성화.
# REDIS_PASSWORD와 다른 값 사용. 기존 백엔드에는 전달하지 않음.
REDIS_READONLY_PASSWORD=

# 선택 Secret. SSH 터널로 접속하는 로컬 Spring Boot 전용 ACL 계정 비밀번호.
# 다른 Redis 비밀번호와 구분하고 실제 값은 저장소에 기록하지 않음.
REDIS_LOCAL_BACKEND_PASSWORD=

# 필수 Secret. JWT HS256 서명 키(최소 32바이트)
JWT_SECRET=

# 필수. 실제 프론트엔드 Origin을 쉼표로 구분
CORS_ALLOWED_ORIGINS=

# 서비스 서버에서는 mock 인증을 사용하지 않음
AUTH_MOCK_ENABLED=false

# 선택. GBT 추천 이유 AI 생성 스위치. 승인 후 true로 설정한다.
GBT_XAI_ENABLED=false

# 선택 Secret. GBT AI 이유 생성에 쓰는 GMS Gateway 키. 실제 값은 GitLab/배포 환경에만 둔다.
GMS_KEY=

# 필수. 가입 인증 메일 링크의 프론트엔드 Base URL(예: https://<도메인> 또는 http://<서비스 노드 IP>)
# CORS_ALLOWED_ORIGINS에 포함된 Origin 중 실제 사용자가 접속하는 주소
FRONTEND_BASE_URL=

# 선택. 발송에 사용할 SMTP 서버. 비우면 Gmail(smtp.gmail.com:587)을 쓴다.
# Gmail이 아닌 전송 서비스로 바꿀 때 이 두 값과 MAIL_FROM을 함께 지정한다.
MAIL_HOST=
MAIL_PORT=

# 필수. SMTP 로그인 계정. 팀 전용 계정을 쓰고 개인 계정은 쓰지 않는다.
# 전송 서비스는 로그인 계정이 발신 주소와 다를 수 있으므로 그때는 MAIL_FROM을 함께 지정한다.
MAIL_USERNAME=

# 필수 Secret. 위 계정의 비밀번호. Gmail은 2단계 인증 후 발급한 앱 비밀번호이고
# 전송 서비스는 발급받은 SMTP 키다. 실제 값은 infra/.env에만 저장
MAIL_PASSWORD=

# 선택. 메일의 발신 주소. 비우면 MAIL_USERNAME을 그대로 쓴다.
# Gmail은 From을 인증 계정으로 강제하므로 비워 둔다.
MAIL_FROM=

# 선택. 계정 메일의 발송 제한이며 이미지를 다시 만들지 않고 여기서 조정한다(S15P21E106-287).
# 값을 바꾼 뒤에는 backend 컨테이너를 다시 만들어야 반영된다. 여기에 없는 값(전역 상한의 창 길이 1시간·24시간)은
# application.yml에만 있으므로 바꾸려면 재배포가 필요하다. 기간 값에 단위를 생략하면 초로 읽는다.
#
# 같은 이메일로 다시 요청할 수 있게 되기까지의 최소 간격.
MAIL_RATE_LIMIT_EMAIL_INTERVAL=1m

# IP 단위 요청 제한. 한 IP 버킷이 가입(API-001), 인증 메일 재발송(API-003), 재설정 요청(API-010)을
# 창 안에서 몇 번 보낼 수 있는지다. 세 경로가 이 카운터를 공유한다. 공용 NAT 뒤에서는 여러 사용자가 한
# 버킷을 공유하므로 값을 내릴 때는 시연 환경의 동시 사용자 수를 함께 본다.
MAIL_RATE_LIMIT_IP_LIMIT=30
MAIL_RATE_LIMIT_IP_WINDOW=1h

# 전역 발송 상한. 가입 인증 메일까지 포함한 실제 발송 건수이며 발송 계정의 쿼터를 지킨다.
# 상한을 넘긴 메일은 응답을 바꾸지 않고 버려지므로, 값을 내릴 때는 정상 사용자의 계정 복구가
# 막힐 수 있다는 점을 함께 본다. 현재 사용량 조회는 backend/README.md를 따른다.
MAIL_SEND_BUDGET_HOURLY_LIMIT=100
MAIL_SEND_BUDGET_DAILY_LIMIT=300

# 브라우저 Web Push. 운영 활성화 시 mode=vapid와 키 쌍·연락처 URI를 함께 설정한다.
# PRIVATE_KEY는 Secret이며 실제 값은 infra/.env에만 저장한다.
WEB_PUSH_MODE=disabled
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:admin@example.com
WEB_PUSH_POLL_INTERVAL=1s
WEB_PUSH_BATCH_SIZE=25
WEB_PUSH_MAXIMUM_ATTEMPTS=5
WEB_PUSH_INITIAL_RETRY_DELAY=1m
WEB_PUSH_MAXIMUM_RETRY_DELAY=1h
WEB_PUSH_LEASE_DURATION=2m
WEB_PUSH_REQUEST_TIMEOUT=15s
