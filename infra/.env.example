# 필수. J15E106 서비스 노드 사설 IP
# Nginx, 애플리케이션 서비스, HDFS DataNode 1, Spark Worker 1
SERVICE_NODE_IP=

# 필수. J15E106A 분산 처리 노드 사설 IP
# HDFS NameNode·DataNode 2, Spark Master·Worker 2, Kafka
DISTRIBUTED_NODE_IP=

# 필수, 비밀정보 아님. KRaft 클러스터 최초 구성 시 한 번 생성
# kafka_data 볼륨을 유지하는 동안 값을 변경하지 않음
KAFKA_CLUSTER_ID=

# 선택. J15E106에서 사용할 Nginx 호스트 포트
NGINX_PORT=80

# 필수. PostgreSQL 컨테이너 초기화에 사용할 데이터베이스와 사용자
POSTGRES_DB=feelm
POSTGRES_USER=feelm
POSTGRES_PASSWORD=

# 필수. GitLab Registry의 백엔드 이미지와 불변 태그(commit SHA)
BACKEND_IMAGE=

# 백엔드가 Compose 내부 PostgreSQL에 연결할 때 사용
DB_URL=jdbc:postgresql://postgres:5432/feelm
DB_USERNAME=feelm

# 필수 Secret. POSTGRES_PASSWORD와 같은 값
DB_PASSWORD=

# 백엔드가 Compose 내부 Redis에 연결할 때 사용
REDIS_HOST=redis
REDIS_PORT=6379

# 필수 Secret. Redis 인증에 사용하며 실제 값은 infra/.env에만 저장
REDIS_PASSWORD=

# 필수 Secret. JWT HS256 서명 키(최소 32바이트)
JWT_SECRET=

# 필수. 실제 프론트엔드 Origin을 쉼표로 구분
CORS_ALLOWED_ORIGINS=

# 서비스 서버에서는 mock 인증을 사용하지 않음
AUTH_MOCK_ENABLED=false