# 필수. J15E106 서비스 노드 사설 IP
# Nginx, 애플리케이션 서비스, HDFS DataNode 1, Spark Worker 1
SERVICE_NODE_IP=

# 필수. J15E106A 분산 처리 노드 사설 IP
# HDFS NameNode·DataNode 2, Spark Master·Worker 2, Kafka
DISTRIBUTED_NODE_IP=

# 필수, 비밀정보 아님. KRaft 클러스터 최초 구성 시 한 번 생성
# kafka_data 볼륨을 유지하는 동안 값을 변경하지 않음
KAFKA_CLUSTER_ID=

# 선택. J15E106에서 사용할 Nginx 호스트 포트
NGINX_PORT=80
