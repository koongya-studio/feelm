# 필수. J15E106 서비스 노드 사설 IP
# Nginx, 애플리케이션 서비스, HDFS DataNode 1, Spark Worker 1
SERVICE_NODE_IP=

# 필수. J15E106A 분산 처리 노드 사설 IP
# HDFS NameNode·DataNode 2, Spark Master·Worker 2, Kafka
DISTRIBUTED_NODE_IP=

# 필수, 비밀정보 아님. KRaft 클러스터 최초 구성 시 한 번 생성
# kafka_data 볼륨을 유지하는 동안 값을 변경하지 않음
KAFKA_CLUSTER_ID=

# 두 서버에서 동일하게 사용할 로컬 Spark ML 이미지 이름과 태그
SPARK_IMAGE=feelm-spark-ml:4.1.3-numpy2.2.6

# 선택. J15E106에서 사용할 Nginx 호스트 포트
NGINX_PORT=80

# 선택. Prometheus와 Grafana는 기본적으로 서비스 호스트 루프백에만 바인딩
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# 필수 Secret. Grafana 최초 관리자 계정에 사용하며 실제 값은 infra/.env에만 저장
GRAFANA_ADMIN_PASSWORD=

# 선택. Prometheus 로컬 보존 기간
PROMETHEUS_RETENTION_TIME=15d

# 선택. 공유 서버에서 Swagger UI와 OpenAPI 문서를 활성화할지 여부
SWAGGER_ENABLED=false

# 선택. Swagger를 활성화할 때 팀 공통 Basic Auth 파일의 서버 호스트 절대 경로
# 비활성 환경은 /dev/null을 사용하며 파일 내용은 저장소에 추가하지 않음
SWAGGER_HTPASSWD_PATH=

# 필수. PostgreSQL 컨테이너 초기화에 사용할 데이터베이스와 사용자
POSTGRES_DB=feelm
POSTGRES_USER=feelm
POSTGRES_PASSWORD=

# 필수. GitLab Registry의 백엔드 이미지와 불변 태그(commit SHA)
BACKEND_IMAGE=

# 서비스 전체 기동 시 사용할 프론트엔드 이미지와 불변 태그(commit SHA)
# 프론트엔드 단독 자동 배포에서는 배포 Job이 후보 이미지를 직접 주입
FRONTEND_IMAGE=

# 백엔드가 Compose 내부 PostgreSQL에 연결할 때 사용
DB_URL=jdbc:postgresql://postgres:5432/feelm
DB_USERNAME=feelm

# 필수 Secret. POSTGRES_PASSWORD와 같은 값
DB_PASSWORD=

# 백엔드가 Compose 내부 Redis에 연결할 때 사용
REDIS_HOST=redis
REDIS_PORT=6379

# 필수 Secret. Redis 인증에 사용하며 실제 값은 infra/.env에만 저장
REDIS_PASSWORD=

# 선택. Kafka 아웃박스 운영 초기값이며 실측 결과에 따라 조정
KAFKA_OUTBOX_POLL_INTERVAL=500ms
KAFKA_OUTBOX_BATCH_SIZE=100
KAFKA_OUTBOX_MAX_RETRY_DELAY=30s
KAFKA_OUTBOX_PUBLISHED_RETENTION=7d
KAFKA_OUTBOX_CLEANUP_INTERVAL=1h

# 선택 Secret. 별도 조회 계정용 비밀번호. 비어 있으면 조회 계정 비활성화.
# REDIS_PASSWORD와 다른 값 사용. 기존 백엔드에는 전달하지 않음.
REDIS_READONLY_PASSWORD=

# 필수 Secret. JWT HS256 서명 키(최소 32바이트)
JWT_SECRET=

# 필수. 실제 프론트엔드 Origin을 쉼표로 구분
CORS_ALLOWED_ORIGINS=

# 서비스 서버에서는 mock 인증을 사용하지 않음
AUTH_MOCK_ENABLED=false

# 필수. 가입 인증 메일 링크의 프론트엔드 Base URL(예: https://<도메인> 또는 http://<서비스 노드 IP>)
# CORS_ALLOWED_ORIGINS에 포함된 Origin 중 실제 사용자가 접속하는 주소
FRONTEND_BASE_URL=

# 필수. 인증 메일 발신용 팀 전용 Gmail 계정(개인 계정 사용 금지)
MAIL_USERNAME=

# 필수 Secret. 위 계정의 Google 앱 비밀번호(2단계 인증 후 발급). 실제 값은 infra/.env에만 저장
MAIL_PASSWORD=

# 선택. 계정 메일의 발송 제한이며 이미지를 다시 만들지 않고 여기서 조정한다(S15P21E106-287).
# 값을 바꾼 뒤에는 backend 컨테이너를 다시 만들어야 반영된다. 여기에 없는 값(전역 상한의 창 길이 1시간·24시간)은
# application.yml에만 있으므로 바꾸려면 재배포가 필요하다. 기간 값에 단위를 생략하면 초로 읽는다.
#
# 같은 이메일로 다시 요청할 수 있게 되기까지의 최소 간격.
MAIL_RATE_LIMIT_EMAIL_INTERVAL=1m

# IP 단위 요청 제한. 한 IP 버킷이 가입(API-001), 인증 메일 재발송(API-003), 재설정 요청(API-010)을
# 창 안에서 몇 번 보낼 수 있는지다. 세 경로가 이 카운터를 공유한다. 공용 NAT 뒤에서는 여러 사용자가 한
# 버킷을 공유하므로 값을 내릴 때는 시연 환경의 동시 사용자 수를 함께 본다.
MAIL_RATE_LIMIT_IP_LIMIT=30
MAIL_RATE_LIMIT_IP_WINDOW=1h

# 전역 발송 상한. 가입 인증 메일까지 포함한 실제 발송 건수이며 발송 계정의 쿼터를 지킨다.
# 상한을 넘긴 메일은 응답을 바꾸지 않고 버려지므로, 값을 내릴 때는 정상 사용자의 계정 복구가
# 막힐 수 있다는 점을 함께 본다. 현재 사용량 조회는 backend/README.md를 따른다.
MAIL_SEND_BUDGET_HOURLY_LIMIT=100
MAIL_SEND_BUDGET_DAILY_LIMIT=300
