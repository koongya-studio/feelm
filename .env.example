# Jira automation. Copy this file to .env and fill in personal values.
# Never commit the copied .env file or real credentials.
JIRA_BASE_URL=
JIRA_PROJECT_KEY=
JIRA_EMAIL=
JIRA_API_TOKEN=
# Required. Every created task is added to this board's active sprint.
JIRA_BOARD_ID=

# Jira-to-Mattermost daily digest. Store real CI values in GitLab CI/CD Variables.
MATTERMOST_BASE_URL=
# Required. Mattermost username or email; the internal user ID is not a login ID.
MATTERMOST_LOGIN_ID=
# Required secret. Use a masked and protected CI/CD variable.
MATTERMOST_PASSWORD=
# Preferred stable target. If set, team/channel names below are not required.
MATTERMOST_CHANNEL_ID=
# Alternative target: slugs from /<team>/channels/<channel> in the channel URL.
MATTERMOST_TEAM_NAME=
MATTERMOST_CHANNEL_NAME=
