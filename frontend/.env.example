# 개발 서버가 /api 요청을 넘길 백엔드 주소. 비워 두면 http://localhost:8080을 쓴다.
# 개발 서버 설정에만 쓰이며 클라이언트 번들에는 들어가지 않는다(vite.config.ts).
VITE_API_PROXY_TARGET=http://localhost:8080

# 소셜 로그인(API-007) client-id. 값이 없는 제공자는 버튼이 잠기고, 눌러도 백엔드가
# UNSUPPORTED_PROVIDER로 답한다. client-id는 공개값이므로 번들에 들어가도 되지만
# client-secret은 백엔드만 가진다.
VITE_GOOGLE_CLIENT_ID=
VITE_KAKAO_CLIENT_ID=
VITE_NAVER_CLIENT_ID=

# 소셜 로그인 콜백 주소. 비워 두면 앱 주소에서 `{origin}/app/oauth/callback`으로 만든다.
# 각 사 콘솔과 백엔드 OAUTH_ALLOWED_REDIRECT_URIS에 등록한 값과 정확히 같아야 하며,
# 등록한 값이 기본 규칙과 다를 때만 적는다.
VITE_OAUTH_REDIRECT_URI=
