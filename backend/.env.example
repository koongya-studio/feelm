# Backend environment variables.
# Copy to .env and fill in local values. Never commit the copied file.

# Required secret. Signing key for JWT (HS256, at least 32 bytes).
# Generate a personal value, e.g. `openssl rand -base64 32`, and keep it only in .env.
# Not loaded automatically: inject it into the shell or pass --env-file to docker run.
JWT_SECRET=

# Datasource. Connects to PostgreSQL published by infra/compose/local.yml.
DB_URL=jdbc:postgresql://localhost:5432/feelm
DB_USERNAME=feelm
DB_PASSWORD=

# Redis. Stores refresh token identifiers.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Kafka transactional outbox. Local Kafka is published by infra/compose/local.yml.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# Polling starts at 500ms; tune it after measuring rating-to-recommendation latency.
KAFKA_OUTBOX_POLL_INTERVAL=500ms
KAFKA_OUTBOX_BATCH_SIZE=100
KAFKA_OUTBOX_MAX_RETRY_DELAY=30s
KAFKA_OUTBOX_PUBLISHED_RETENTION=7d
KAFKA_OUTBOX_CLEANUP_INTERVAL=1h

# Comma-separated browser origins allowed to send credentials.
# A wildcard cannot be used because the refresh token cookie requires credentials.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# OpenAPI JSON and Swagger UI. Disabled unless explicitly enabled.
SWAGGER_ENABLED=false

# Base URL of the frontend. Used to build the email verification link.
FRONTEND_BASE_URL=http://localhost:5173

# Required. Verification mail delivery. `log` prints the verification link instead of sending mail and is
# meant for local checks only; the application fails to start if it is used outside local and test.
# Set `smtp` together with the credentials below to send real mail.
MAIL_MODE=log
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
# Team mail account and its app password. The password is a secret: keep it only in .env.
MAIL_USERNAME=
MAIL_PASSWORD=
# Optional sender address. Gmail rewrites From to the authenticated account, so leave it empty
# for smtp mode; the value below is only shown in log mode.
MAIL_FROM=no-reply@feelm.local
# Optional delivery throttling defaults. Tune only after measuring the deployment workload.
MAIL_RATE_LIMIT_EMAIL_INTERVAL=1m
MAIL_RATE_LIMIT_IP_LIMIT=30
MAIL_RATE_LIMIT_IP_WINDOW=1h
MAIL_SEND_BUDGET_HOURLY_LIMIT=100
MAIL_SEND_BUDGET_DAILY_LIMIT=300

# Social login (API-007~009). Comma-separated exact redirect URIs the backend accepts; requests with
# any other value are rejected without calling the provider. Leave empty to disable social login.
OAUTH_ALLOWED_REDIRECT_URIS=http://localhost:5173/oauth/callback,http://localhost:5173/oauth/link-callback
# Per-provider app credentials. A provider without a client id is not registered and answers
# UNSUPPORTED_PROVIDER, so fill in only the providers you have credentials for. The secrets belong in
# .env only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Development convenience, off by default. Injects a fixed user so member APIs can be called
# without logging in. It disables authentication, so turn it on only while you need it.
AUTH_MOCK_ENABLED=false
AUTH_MOCK_USER_ID=1

# Candidate v6 전환: 활성 vector/candidates를 모두 v6로 재게시·확인한 뒤 false로 변경.
RECOMMENDATION_ACCEPT_V5=true
# 추천 이유 생성기. API 키가 비어 있으면 확인된 근거의 결정적 문구를 사용한다.
# 실제 키는 .env 또는 배포 Secret에만 넣는다.
GMS_KEY=
GEMINI_REASON_MODEL=gemini-2.5-flash-lite

# Browser Web Push. `disabled` keeps the public config endpoint available but rejects subscription
# changes and does not start the delivery worker. Generate one VAPID key pair for the deployment;
# the private key is a secret and must never be committed or exposed to the browser.
WEB_PUSH_MODE=disabled
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:admin@example.com
WEB_PUSH_POLL_INTERVAL=1s
WEB_PUSH_BATCH_SIZE=25
WEB_PUSH_MAXIMUM_ATTEMPTS=5
WEB_PUSH_INITIAL_RETRY_DELAY=1m
WEB_PUSH_MAXIMUM_RETRY_DELAY=1h
WEB_PUSH_LEASE_DURATION=2m
WEB_PUSH_REQUEST_TIMEOUT=15s
